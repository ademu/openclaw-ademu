{
  "name": "@ademu/openclaw-ademu",
  "version": "0.1.0",
  "description": "Ademú channel plugin for OpenClaw — end-to-end encrypted messaging with your agent, from your phone.",
  "type": "module",
  "license": "MIT",
  "author": "Ademú <npm@ademu.com> (https://ademu.com)",
  "homepage": "https://github.com/ademu/openclaw-ademu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ademu/openclaw-ademu.git"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "assets",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.build.json",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "vitest run",
    "privacy-audit": "dev/privacy-audit.sh",
    "icon": "node scripts/make-icon.mjs",
    "pack:check": "npm pack --dry-run --json",
    "ci:acceptance": "scripts/ci-acceptance.sh"
  },
  "dependencies": {
    "@ademu/adc-bin": "0.2.4",
    "@ademu/adc-client": "^0.1.1",
    "@ademu/adc-control": "^0.1.1",
    "typebox": "^1.3.17",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "ademu",
      "label": "Ademú",
      "selectionLabel": "Ademú (end-to-end encrypted)",
      "blurb": "End-to-end encrypted messaging with your agent, from your phone; install the plugin to enable.",
      "order": 95
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "install": {
      "minHostVersion": ">=2026.8.1",
      "npmSpec": "@ademu/openclaw-ademu",
      "clawhubSpec": "ademu/openclaw-ademu",
      "defaultChoice": "npm"
    },
    "build": {
      "openclawVersion": "2026.9.1"
    }
  }
}
